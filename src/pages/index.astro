---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import SortingBackground from '../components/SortingBackground.astro';

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
const withBase = (path = '') => `${baseUrl}${path.replace(/^\/+/, '')}`;
const cvVersion = createHash('sha256')
	.update(readFileSync(resolve('public/cv.pdf')))
	.digest('hex').slice(0, 12);
const cvUrl = `${withBase('cv.pdf')}?v=${cvVersion}`;
const builtAt = new Date();
const builtAtLabel = new Intl.DateTimeFormat('en-GB', {
	day: '2-digit',
	month: 'short',
	year: 'numeric',
	hour: '2-digit',
	minute: '2-digit',
	hour12: false,
	timeZone: 'UTC',
}).format(builtAt);
---

